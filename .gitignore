# Local, machine-specific configuration. Copy the .example files on a new machine:
#   cp .env.example .env && cp config.example.yaml config.yaml
# Anchored to the repo root: an unanchored "config.yaml" also matched, and
# silently dropped, tests/fixtures/config.yaml.
.env
/config.yaml

# Backups written by scripts/swarm_config.py
*.bak

# Backups written by the dashboard before it updates config.yaml
config_backups/

# Visualizer frames, mounted into Docker 6.
artefacts/*
!artefacts/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Docker 1 backend. Use crazyswarm for the current ROS 2/CrazySwarm API.
DRONE_MODE=crazyswarm
CRAZYSWARM_API_URL=http://127.0.0.1:8011
CRAZYSWARM_API_KEY=
MISSION_AUTO_START=1

# Where the dashboard's debug panel checks for the bridge. Docker 1 reaches
# the bridge over the host network, but the dashboard does not, so this uses
# host.docker.internal instead of 127.0.0.1.
#CRAZYSWARM_BRIDGE_URL=http://host.docker.internal:8011

# Optional. Where services read config.yaml from. Unset, it resolves to the
# repo-root copy: /app/config.yaml in a container, ./config.yaml on
# the host. Set it only to point at a fixture or an alternate config.
#CONFIG_PATH=

# Where CrazySwarm's crazyflies.yaml lives, used by the dashboard's "drone IDs
# from CrazySwarm" button. The default assumes both repos sit side by side.
#CRAZYFLIES_DIR=../CrazySwarm2-with-Mocap/src/crazyswarm2/crazyflie/config

AUTO_DOWN_IDS=
AUTO_DOWN_COUNT=
AUTO_DOWN_AFTER_SEC=0

VIS_WIDTH=900
VIS_HEIGHT=700
VIS_SCALE=500.0
VIS_FPS=5.0
SAFETY_GAP=0.25
